{
  "name": "ai-ticket-it",
  "version": "0.1.0",
  "private": true,
  "description": "AI Ticket It: plataforma de venta de entradas para eventos. TP individual de Desarrollo con IA, DDS UTN FRBA 2C 2026.",
  "workspaces": [
    "packages/*"
